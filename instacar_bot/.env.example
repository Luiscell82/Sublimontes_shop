# ── Telegram ───────────────────────────────────────────────
# 1. Habla con @BotFather en Telegram y crea un nuevo bot → te da el TOKEN
# 2. Para obtener tu CHAT_ID: inicia conversación con @userinfobot
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=987654321

# ── Credenciales Instacar ──────────────────────────────────
INSTACAR_EMAIL=tu@email.com
INSTACAR_PASSWORD=tupassword

# ── Configuración de monitoreo ─────────────────────────────
# Cada cuántos minutos revisar (mínimo recomendado: 10)
CHECK_INTERVAL_MINUTES=15

# ── Filtros de lotes ───────────────────────────────────────
# Kilometraje máximo aceptable (0 = sin límite)
MAX_MILEAGE_KM=80000

# Año mínimo del vehículo (0 = sin límite)
MIN_YEAR=2018

# Precio máximo en MXN (0 = sin límite)
MAX_PRICE_MXN=0

# Puntuación mínima para notificar (0-100)
MIN_SCORE=50

# Marcas prioritarias (separadas por coma, vacío = todas)
BRANDS_PRIORITY=TOYOTA,HONDA,NISSAN,MAZDA,KIA

# ── Debug ──────────────────────────────────────────────────
# Pon false para ver el navegador en pantalla (útil para depurar)
HEADLESS=true
